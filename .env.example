# Copy this file to `.env` and edit. NEVER commit the real .env to git.

# Which data source to sync from:
#   mock       -> built-in fake orders (no setup, good for testing)
#   robinhood  -> Robinhood's official Agentic Trading MCP
DATA_SOURCE=mock

# Robinhood's official MCP endpoint (launched May 2026).
ROBINHOOD_MCP_URL=https://agent.robinhood.com/mcp/trading

# Exact name of the order-history tool on the MCP server. Auto-detection
# works, but the server also exposes `review_equity_order`, which the name
# heuristic does NOT rule out — so pin this rather than leaving it to luck.
ROBINHOOD_ORDERS_TOOL=get_equity_orders

# REQUIRED: the account whose trades you want to record. The order-history
# tool errors out without it. This is your everyday brokerage account, not
# the Agentic one (which exists only to satisfy Robinhood's connect flow).
ROBINHOOD_ACCOUNT_NUMBER=

# How far back to ask Robinhood for orders.
#   auto        -> start 5 days before the newest fill already stored. Keeps
#                  a scheduled run to one page instead of re-walking all
#                  history, and never needs updating. Recommended once your
#                  first backfill has finished.
#   YYYY-MM-DD  -> fixed lower bound.
#   blank       -> full backfill, every page of history.
ROBINHOOD_SINCE=

# Where OAuth tokens are cached, relative to this folder. Contains live
# credentials to your brokerage account: never commit or share it.
ROBINHOOD_TOKEN_FILE=.rh_tokens.json

# Local port that catches Robinhood's OAuth redirect. Change only if 3030
# is already in use on your Mac.
ROBINHOOD_CALLBACK_PORT=3030

# Set to 1 for unattended runs (cron). If Robinhood ever needs a fresh login,
# fail immediately with a clear message instead of opening a browser nobody
# is watching and blocking until the OAuth timeout.
ROBINHOOD_NO_BROWSER=

# Set to 1 to print what came back and exit WITHOUT writing to the database.
DRY_RUN=
